<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tecno Tech Oberá | Tienda Oficial</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
  <style>
    :root { --primary: #0f172a; --accent: #25D366; --bg: #f8fafc; --card: #fff; --text: #334155; }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
    body { background: var(--bg); color: var(--text); min-height: 100vh; display: flex; flex-direction: column; }
    
    header { background: var(--card); padding: 14px 20px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2px 10px rgba(0,0,0,.05); position: sticky; top: 0; z-index: 50; }
    .logo { font-weight: 800; font-size: 18px; color: var(--primary); }
    .logo span { color: var(--accent); }
    #btn-carrito { background: var(--primary); color: #fff; border: none; padding: 10px 16px; border-radius: 20px; font-weight: 600; cursor: pointer; transition: 0.2s; }
    #btn-carrito:hover { background: #1e293b; }
    
    .hero { background: linear-gradient(135deg, #1e293b, #0f172a); color: #fff; padding: 28px 20px; text-align: center; }
    .hero h2 { font-weight: 800; margin-bottom: 6px; font-size: 1.3rem; }
    .hero p { font-size: 0.9rem; opacity: 0.9; }
    
    .cat-wrap { background: var(--card); padding: 12px 0; position: sticky; top: 58px; z-index: 40; box-shadow: 0 2px 8px rgba(0,0,0,.04); }
    .cat-scroll { display: flex; gap: 10px; overflow-x: auto; padding: 0 20px; scrollbar-width: none; }
    .cat-scroll::-webkit-scrollbar { display: none; }
    .cat-btn { border: 2px solid transparent; background: #f1f5f9; padding: 10px 14px; border-radius: 20px; font-weight: 600; font-size: 13px; white-space: nowrap; cursor: pointer; display: flex; gap: 6px; align-items: center; color: var(--text); transition: 0.2s; }
    .cat-btn.activo { background: #eff6ff; border-color: #3b82f6; color: #1d4ed8; }
    
    .container { max-width: 1200px; margin: auto; width: 100%; padding: 20px; flex: 1; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; }
    
    .card { background: var(--card); border-radius: 16px; padding: 10px; box-shadow: 0 4px 15px rgba(0,0,0,.04); display: flex; flex-direction: column; transition: transform 0.2s; }
    .card:hover { transform: translateY(-4px); }
    .card img { width: 100%; aspect-ratio: 1/1; object-fit: cover; border-radius: 10px; background: #f1f5f9; }
    .card h3 { font-size: 13px; font-weight: 600; margin: 8px 0 4px; color: var(--primary); line-height: 1.2; }
    .card .desc { font-size: 11px; color: #64748b; margin-bottom: 6px; }
    .precio { color: #0a7d32; font-weight: 800; font-size: 15px; margin-bottom: 10px; margin-top: auto; }
    .card button.agregar { margin-top: auto; background: var(--primary); color: #fff; border: none; padding: 8px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: 0.2s; }
    .card button.agregar:hover { background: #1e293b; }
    
    footer { background: var(--primary); color: #fff; text-align: center; padding: 24px; margin-top: 30px; font-size: 0.9rem; }
    
    #panel { position: fixed; right: -100%; top: 0; width: 380px; max-width: 100%; height: 100%; background: #fff; padding: 20px; transition: .3s; z-index: 100; display: flex; flex-direction: column; box-shadow: -5px 0 20px rgba(0,0,0,.2); }
    #panel.abierto { right: 0; }
    #fondo { position: fixed; inset: 0; background: rgba(0,0,0,.5); display: none; z-index: 99; }
    #fondo.activo { display: block; }
    
    #modal { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: none; align-items: center; justify-content: center; z-index: 200; padding: 20px; }
    .modal-box { background: #fff; padding: 22px; border-radius: 16px; max-width: 400px; width: 100%; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
    
    .wa-float { position: fixed; bottom: 20px; right: 20px; background: var(--accent); color: #fff; width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 26px; z-index: 90; text-decoration: none; box-shadow: 0 4px 12px rgba(0,0,0,.2); transition: 0.2s; }
    .wa-float:hover { transform: scale(1.1); }
  </style>
</head>
<body>

  <header>
    <div class="logo">Tecno Tech <span>Oberá</span></div>
    <button id="btn-carrito"><i class="fa-solid fa-bag-shopping"></i> Carrito (<span id="contador">0</span>)</button>
  </header>

  <div class="hero">
    <h2>Bienvenidos a Tecno Tech Oberá</h2>
    <p>Hacé tu pedido, transferí a alias <b>mundo95</b> y enviá comprobante por WhatsApp</p>
  </div>

  <div class="cat-wrap">
    <div class="cat-scroll" id="cats"></div>
  </div>

  <main class="container">
    <h2 id="titulo" style="font-size:16px;font-weight:800;margin-bottom:14px">Todos los productos</h2>
    <div class="grid" id="grid"></div>
  </main>

  <footer>
    <p>Av. Italia 1459, Oberá - 3755 223737 - Envíos en 72hs</p>
  </footer>

  <!-- PANEL DEL CARRITO -->
  <div id="fondo"></div>
  <div id="panel">
    <button id="cerrar-panel" style="align-self:flex-end;border:none;background:#f1f5f9;width:32px;height:32px;border-radius:50%;cursor:pointer">✕</button>
    <h3 style="margin:10px 0;color:var(--primary)">Tu pedido</h3>
    <div id="lista" style="flex:1;overflow:auto"></div>
    <div id="total" style="font-weight:800;text-align:right;margin:12px 0;font-size:18px"></div>
    <button id="btn-checkout" style="background:#25D366;color:#fff;border:none;padding:14px;border-radius:10px;font-weight:700;cursor:pointer">Confirmar pedido</button>
  </div>

  <!-- MODAL DE PAGO -->
  <div id="modal">
    <div class="modal-box">
      <h3 style="color:var(--primary)">¡Casi listo!</h3>
      <p style="margin:10px 0;font-size:14px;color:#64748b">Transferí a los siguientes datos:</p>
      <div style="background:#f8fafc;border:1px dashed #cbd5e1;padding:12px;border-radius:8px;text-align:left">
        <div style="font-weight:800;font-size:16px;color:var(--primary)">Alias: mundo95</div>
        <div style="font-size:14px;color:#334155">Matias Gonzalo Lepori</div>
        <div style="font-size:12px;color:#64748b;margin-top:4px">CVU: 000000310007... (Mercado Pago)</div>
      </div>
      <p style="font-size:12px;color:#64748b;margin-top:12px">Luego abrí WhatsApp y adjuntá tu comprobante.</p>
      <button id="btn-wa" style="background:#25D366;color:#fff;border:none;padding:12px;border-radius:8px;width:100%;margin-top:14px;font-weight:700;cursor:pointer"><i class="fa-brands fa-whatsapp"></i> Abrir WhatsApp</button>
      <button id="btn-cerrar-modal" style="background:none;border:none;color:#888;margin-top:10px;text-decoration:underline;cursor:pointer">Cancelar</button>
    </div>
  </div>

  <a class="wa-float" href="https://wa.me/5493755223737" target="_blank">
    <i class="fa-brands fa-whatsapp"></i>
  </a>

  <script>
    const WHATSAPP = "5493755223737";
    const fallback = (t) => `https://placehold.co/400x400/f1f5f9/0f172a?text=${encodeURIComponent(t.substring(0,20))}`;

    // ====== TUS PRODUCTOS ======
    const PRODUCTOS = [
      {id:"p001",nombre:"Termo 1L Rosa",precio:38900,categoria:"Termos, Mates y Vasos",imagenes:["img/img_tecnotech_001.jpg"]},
      {id:"p002",nombre:"Termo 1L Rojo",precio:38900,categoria:"Termos, Mates y Vasos",imagenes:["img/img_tecnotech_002.jpg"]},
      {id:"p003",nombre:"Termo 1L Blanco",precio:38900,categoria:"Termos, Mates y Vasos",imagenes:["img/img_tecnotech_003.jpg"]},
      {id:"p004",nombre:"Termo 1L Bordo",precio:38900,categoria:"Termos, Mates y Vasos",imagenes:["img/img_tecnotech_004.jpg"]},
      {id:"p005",nombre:"Termo 1L Lila",precio:38900,categoria:"Termos, Mates y Vasos",imagenes:["img/img_tecnotech_005.jpg"]},
      {id:"p006",nombre:"Termo 1L Combo x4",precio:38900,categoria:"Termos, Mates y Vasos",imagenes:["img/img_tecnotech_006.jpg"]},
      {id:"p007",nombre:"Termo 1L Rosa Claro",precio:38900,categoria:"Termos, Mates y Vasos",imagenes:["img/img_tecnotech_007.jpg"]},
      {id:"p176",nombre:"PC Gamer Completa i3 GTX 750 Ti",precio:480000,categoria:"Accesorios y Tecnologia",imagenes:["img/p176-1.jpg"]}
    ];

    // Categorías (Ajustadas a tus productos)
    const CATS = ["Todos","Termos, Mates y Vasos","Accesorios y Tecnologia","Bazar","Belleza y Cuidado Personal","Blanquería"];
    
    let carrito = JSON.parse(localStorage.getItem("carrito") || "[]");
    let catAct = "Todos";
    
    const grid = document.getElementById("grid");
    const catBar = document.getElementById("cats");
    const titulo = document.getElementById("titulo");
    const fmt = n => n.toLocaleString("es-AR");

    // Renderizar categorías
    function renderCats() {
      catBar.innerHTML = "";
      CATS.forEach(c => {
        if(c !== "Todos" && !PRODUCTOS.some(p => p.categoria === c)) return;
        const b = document.createElement("button");
        b.className = `cat-btn ${catAct === c ? "activo" : ""}`;
        let icono = c === "Termos, Mates y Vasos" ? "fa-mug-hot" : c === "Bazar" ? "fa-utensils" : c === "Belleza y Cuidado Personal" ? "fa-spa" : c === "Blanquería" ? "fa-bed" : c === "Accesorios y Tecnologia" ? "fa-laptop" : "fa-box";
        b.innerHTML = `<i class="fa-solid ${icono}"></i> ${c}`;
        b.onclick = () => { catAct = c; renderCats(); render(); };
        catBar.appendChild(b);
      });
    }

    // Renderizar productos
    function render() {
      grid.innerHTML = "";
      titulo.textContent = catAct === "Todos" ? `Todos los productos (${PRODUCTOS.length})` : catAct;
      
      PRODUCTOS.filter(p => catAct === "Todos" || p.categoria === catAct).forEach(p => {
        const card = document.createElement("div");
        card.className = "card";
        card.innerHTML = `
          <img src="${p.imagenes[0]}" loading="lazy" onerror="this.src='${fallback(p.nombre)}'">
          <h3>${p.nombre}</h3>
          ${p.desc ? `<div class="desc">${p.desc}</div>` : ""}
          <div class="precio">$${fmt(p.precio)}</div>
          <button class="agregar">Añadir</button>
        `;
        card.querySelector(".agregar").onclick = () => {
          const ex = carrito.find(i => i.id === p.id);
          if(ex) ex.c++;
          else carrito.push({ id: p.id, n: p.nombre, p: p.precio, c: 1 });
          localStorage.setItem("carrito", JSON.stringify(carrito));
          updateCart();
        };
        grid.appendChild(card);
      });
    }

    // Actualizar carrito
    function updateCart() {
      document.getElementById("contador").textContent = carrito.reduce((s, i) => s + i.c, 0);
      const lista = document.getElementById("lista");
      const totalEl = document.getElementById("total");
      
      if(carrito.length === 0) {
        lista.innerHTML = "<p style='color:#94a3b8;text-align:center;margin-top:40px'>El carrito está vacío</p>";
        totalEl.textContent = "";
        return;
      }
      
      lista.innerHTML = "";
      let tot = 0;
      carrito.forEach((it, i) => {
        const pr = PRODUCTOS.find(x => x.id === it.id);
        if (!pr) return;
        tot += pr.precio * it.c;
        const d = document.createElement("div");
        d.style.display = "flex";
        d.style.justifyContent = "space-between";
        d.style.alignItems = "center";
        d.style.padding = "10px 0";
        d.style.borderBottom = "1px solid #eee";
        d.innerHTML = `
          <div><b>${pr.nombre.substring(0, 28)}</b> x${it.c}</div>
          <button style="border:none;background:#fee2e2;color:#ef4444;border-radius:6px;padding:4px 8px;cursor:pointer">✕</button>
        `;
        d.querySelector("button").onclick = () => {
          carrito.splice(i, 1);
          localStorage.setItem("carrito", JSON.stringify(carrito));
          updateCart();
        };
        lista.appendChild(d);
      });
      totalEl.textContent = `Total: $${fmt(tot)}`;
    }

    // Abrir y cerrar panel del carrito
    const panel = document.getElementById("panel");
    const fondo = document.getElementById("fondo");
    
    document.getElementById("btn-carrito").onclick = () => { panel.classList.add("abierto"); fondo.classList.add("activo"); };
    document.getElementById("cerrar-panel").onclick = () => { panel.classList.remove("abierto"); fondo.classList.remove("activo"); };
    fondo.onclick = () => { panel.classList.remove("abierto"); fondo.classList.remove("activo"); };

    // Modal de pago
    const modal = document.getElementById("modal");
    document.getElementById("btn-checkout").onclick = () => {
      if(carrito.length === 0) return alert("Agregá productos al carrito primero.");
      modal.style.display = "flex";
    };
    
    document.getElementById("btn-cerrar-modal").onclick = () => { modal.style.display = "none"; };

    // Confirmar pedido y enviar a WhatsApp
    document.getElementById("btn-wa").onclick = () => {
      let mensaje = "Hola! Quiero confirmar este pedido:%0A%0A";
      let total = 0;
      carrito.forEach(item => {
        total += item.p * item.c;
        mensaje += `• ${item.c}x ${item.n} — $${fmt(item.p * item.c)}%0A`;
      });
      mensaje += `%0A*Total: $${fmt(total)}*%0A%0AYa realicé la transferencia al alias mundo95. *Adjunto el comprobante acá abajo* 👇`;
      window.open(`https://wa.me/${WHATSAPP}?text=${mensaje}`, "_blank");
      modal.style.display = "none";
      panel.classList.remove("abierto"); 
      fondo.classList.remove("activo");
    };

    // Inicializar la página
    renderCats();
    render();
    updateCart();
  </script>
</body>
</html>